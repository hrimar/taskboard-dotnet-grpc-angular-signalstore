<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled once, here. Every other project gets the generated types via ProjectReference.
         "Both" (not "Server") so the integration tests can reuse the generated C# clients instead
         of compiling the protos a second time, which would duplicate the message types. -->
    <Protobuf Include="Protos\*.proto" GrpcServices="Both" ProtoRoot="Protos\" />

    <!-- google/api/*.proto define the `google.api.http` option that maps an RPC to a REST route
         (JSON transcoding). They are only imported for that option, so they define no services. -->
    <Protobuf Include="Protos\google\api\*.proto" GrpcServices="None" ProtoRoot="Protos\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Core.Api" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
