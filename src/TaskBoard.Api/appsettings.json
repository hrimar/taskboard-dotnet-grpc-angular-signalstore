{
  "ConnectionStrings": {
    "TaskBoard": "Data Source=taskboard.db"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      // Http2-only was fine for a pure gRPC/Postman setup, but a browser calling
      // gRPC-Web over plain HTTP (no TLS) can only speak HTTP/1.1 - browsers never
      // negotiate HTTP/2 without TLS (h2c isn't supported client-side). Allowing
      // both lets native gRPC clients keep using HTTP/2 while the Angular app uses
      // HTTP/1.1 on the same port.
      "Protocols": "Http1AndHttp2"
    }
  }
}
